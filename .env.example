# ── Email (Resend) ────────────────────────────────────────────────────────
# The contact form sends via Resend. Two required vars:

# 1. API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 2. Verified sender. The iamsaurabh.in domain must be verified in Resend
#    (add the DKIM/SPF/DMARC records it gives you into Cloudflare DNS).
MAIL_FROM="Saurabh Singh <hello@iamsaurabh.in>"

# Optional: where owner notifications land. Defaults to hello@iamsaurabh.in,
# which Cloudflare Email Routing forwards to your personal inbox. Set this only
# if you want notifications sent somewhere else.
# CONTACT_TO=singhsaurabh162000@gmail.com

# ── Security ──────────────────────────────────────────────────────────────
# The contact API only accepts requests from our own origin. The apex + www of
# the site domain and (in dev) localhost are allowed automatically. Add extra
# origins here, comma-separated — e.g. a Vercel preview URL you test forms on.
# ALLOWED_ORIGINS=https://saurabh-singh-portfolio.vercel.app
